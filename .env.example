# Copie para .env.local para rodar no seu computador.
# No Netlify, cadastre em Site configuration > Environment variables
# (escopo: Builds, Functions e Runtime).

# Públicas (vão para o navegador e para a prévia do link)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Secretas (só nas funções do servidor; nunca com prefixo VITE_)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Proteção contra robôs (Cloudflare Turnstile), opcional: preencha as duas ou nenhuma.
# A Site Key é pública; a Secret Key é secreta (só no servidor).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
